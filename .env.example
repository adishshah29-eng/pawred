# Copy this file to .env and fill in the values. Never commit .env.

# --- PostgreSQL (Supabase) ---
# Supabase dashboard > Connect > ORMs > Prisma.
# Pooled connection (Transaction pooler, port 6543) used by the app:
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Direct / session connection (port 5432) used by Prisma migrations and seed:
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Phase 4) ---
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Public site address (used for sitemap, social cards). Your Vercel URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Storage (Phase 5) ---
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Demo mode (Phase 11) ---
# Shared password of the 3 demo accounts created by `npm run db:seed`.
DEMO_PASSWORD=""
# "true" shows one-click demo sign-in buttons on /sign-in. Turn OFF for the real launch.
DEMO_MODE="false"
